# АРХИ-ЩИТ — тиковая логика. Контекст: as <игрок со щитом>, at @s.
# Вызывается из nuke:tick по прямой проверке компонента щита в главной/левой руке.
# Никаких чтений NBT-позы и скорбордов урона — только частицы и предикат скрытности.

# Пассивная индикация у ног игрока (1 частица за тик, не мешает обзору).
particle minecraft:end_rod ~ ~0.2 ~ 0.3 0.2 0.3 0.008 1 force

# Активный барьер при зажатом Shift — строго через системный предикат.
execute if entity @s[predicate=nuke:is_sneaking] run function nuke:archi_shield/sneak_active
