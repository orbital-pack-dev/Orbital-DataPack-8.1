{
  "type": "minecraft:multi_action",
  "title": {
    "text": "👤 Личные перезарядки (personal_cd)",
    "color": "#55ff55",
    "bold": true
  },
  "body": {
    "type": "minecraft:plain_message",
    "contents": {
      "text": "1 = индивидуальный КД для каждого игрока, 0 = без КД.",
      "color": "gray"
    }
  },
  "columns": 2,
  "can_close_with_escape": true,
  "actions": [
    {
      "label": {
        "text": "🔴 ВЫКЛЮЧИТЬ (0)",
        "color": "#ff5555"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger t_personal_cd set 0"
      }
    },
    {
      "label": {
        "text": "🟢 ВКЛЮЧИТЬ (1)",
        "color": "#55ff55"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger t_personal_cd set 1"
      }
    },
    {
      "label": {
        "text": "📊 Показать значение",
        "color": "#55ff55"
      },
      "width": 302,
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger t_info set 1"
      }
    },
    {
      "label": {
        "text": "⬅️ Назад в Главное Меню",
        "color": "#ffff55"
      },
      "width": 302,
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "nuke:main"
      }
    }
  ]
}