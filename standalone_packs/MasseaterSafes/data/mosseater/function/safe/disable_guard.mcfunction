# БАГ 2 — снятие защиты СТРОГО с текущего блока.
# Контекст: as <маркер сейфа>, at <маркер>.
#
# Функция намеренно не содержит ни одного селектора шире 0.8 блока и никогда
# не вызывается по площади: её запускают поимённо для каждого маркера из
# набора ms_safe_pair. Независимый сосед в 1 блоке остаётся с хитбоксом и
# ванильным замком.
kill @e[tag=ms_safe_shield,distance=..0.8,type=minecraft:interaction]
execute align xyz run data remove block ~ ~ ~ components."minecraft:lock"
